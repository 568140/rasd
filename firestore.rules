rules_version = '2';

// ============================================================================
// مسودة قواعد الأمان المتوافقة بالكامل (DRAFT_firestore.rules) — المرحلة 1B
// ============================================================================
// تحذير أمني إلزامي (Stage 1B-5):
// هذه المسودة مخصصة للمراجعة والاختبار المعزول فقط، ولا تُعتبر آمنة للنشر على الإنتاج
// قبل اختبارها الفعلي على محرك Firestore الرسمي (Firebase Emulator أو مشروع اختباري منفصل).
// لم يتم تعديل ملف الإنتاج (/firestore.rules) ولم يتم نشر أي قاعدة جديدة.
//
// ----------------------------------------------------------------------------
// توثيق الفروق والمواءمة بين المخطط الفعلي للإنتاج والمخطط المقترح (Stage 1B-3 & 1B-4):
// 1. حقل مالك مساحة العمل والسجلات:
//    - المخطط الفعلي في الإنتاج (/firestore.rules والكود): يستخدم `ownerId` في جميع المجموعات.
//    - المسودة المختزلة السابقة: استخدمت بالخطأ `ownerUid`.
//    - القرار المعتمد هنا: توحيد جميع القواعد والكيانات (بما فيها `account_licenses`) على `ownerId`.
// 2. أدوار أعضاء الفريق في `/workspace_members/{memberId}`:
//    - المخطط الفعلي في الإنتاج: `['owner', 'field_assistant', 'finance_assistant', 'viewer']`
//      مع حقلي الصلاحيات المنطقية `canApproveFinancials` و `canDeleteRecords`.
//    - المسودة المختزلة السابقة: افترضت أدوارًا غير موجودة (`admin`, `finance_manager`, `field_officer`).
//    - القرار المعتمد هنا: الإبقاء الكامل على الأدوار الأربعة الفعلية وحقول الصلاحيات الدقيقة دون اختزال.
// 3. توحيد اسم مجموعة التراخيص والاشتراكات (Stage 1B-4):
//    - تم توحيد الاسم في كافة الوثائق والمسودات والاختبارات إلى: `account_licenses`
//      (وإلغاء أي إشارة للاسم `tenant_licenses`).
// 4. الحفاظ على دوال التحقق الصارمة (`isValid[Entity]`) واستعلامات القوائم الآمنة (`allow list`):
//    - تم بناء هذه المسودة فوق النص الكامل لملف `/firestore.rules` (771 سطرًا) دون حذف أي دالة تحقق
//      أو شرط عضوية (`request.auth.uid in existing().memberUids`) أو قفل حالة نهائية.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives & Identity Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn();
    }

    // المالكان الدائمان للمنصة بصلاحيات متساوية وكاملة ودون اشتراك (مجانًا مدى الحياة):
    // 1. المالك الرئيسي: am1075022@gmail.com
    // 2. المالك الاحتياطي: ahah26@gmail.com / ahah26h@gmail.com
    function isPermanentOwnerEmail(email) {
      return email is string && (
        email == 'am1075022@gmail.com' ||
        email == 'ahah26@gmail.com' ||
        email == 'ahah26h@gmail.com' ||
        email.lower() == 'am1075022@gmail.com' ||
        email.lower() == 'ahah26@gmail.com' ||
        email.lower() == 'ahah26h@gmail.com'
      );
    }

    function hasTopLevelTokenEmail() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.size() > 0;
    }

    function isTopLevelEmailVerified() {
      return isSignedIn() &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true;
    }

    function matchesAuthTokenEmail(candidateEmail) {
      return candidateEmail is string &&
        hasTopLevelTokenEmail() && (
          candidateEmail == request.auth.token.email ||
          candidateEmail.lower() == request.auth.token.email.lower()
        );
    }

    function matchesAuthTokenEmailOrMissing(candidateEmail) {
      return candidateEmail is string && (
        !hasTopLevelTokenEmail() ||
        matchesAuthTokenEmail(candidateEmail)
      );
    }

    // التحقق من هوية المالك الدائم الموثقة من رمز الجلسة الموقّع رقميًا من Firebase Auth (JWT)
    // يدعم:
    // 1. البريد الموثق في المستوى الأعلى للرمز ('email_verified' in request.auth.token && request.auth.token.email_verified == true)
    // 2. تسجيل الدخول الموثق عبر مزود Google (sign_in_provider == 'google.com') حتى عند غياب البريد من المستوى الأعلى
    //    بفحص request.auth.token.email أو قوائم الهويات الموقعة داخل request.auth.token.firebase.identities
    function isGoogleAuthenticatedToken() {
      return isSignedIn() &&
        'firebase' in request.auth.token &&
        request.auth.token.firebase is map &&
        'sign_in_provider' in request.auth.token.firebase &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function hasPermanentOwnerInIdentityList(identitiesMap, providerKey) {
      return identitiesMap is map &&
        providerKey in identitiesMap &&
        identitiesMap[providerKey] is list && (
          'am1075022@gmail.com' in identitiesMap[providerKey] ||
          'ahah26@gmail.com' in identitiesMap[providerKey] ||
          'ahah26h@gmail.com' in identitiesMap[providerKey]
        );
    }

    function hasVerifiedOwnerTokenClaim() {
      return isSignedIn() && (
        (
          isTopLevelEmailVerified() &&
          hasTopLevelTokenEmail() &&
          isPermanentOwnerEmail(request.auth.token.email)
        ) || (
          isGoogleAuthenticatedToken() && (
            (hasTopLevelTokenEmail() && isPermanentOwnerEmail(request.auth.token.email)) ||
            (
              'identities' in request.auth.token.firebase && (
                hasPermanentOwnerInIdentityList(request.auth.token.firebase.identities, 'email') ||
                hasPermanentOwnerInIdentityList(request.auth.token.firebase.identities, 'google.com')
              )
            )
          )
        )
      );
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        hasVerifiedOwnerTokenClaim()
      );
    }

    function isPlatformOwner() {
      return isAdmin();
    }

    // التحقق من كون المستخدم مساعد منصة نشطًا
    function isActivePlatformStaff() {
      let staffPath = /databases/$(database)/documents/platform_staff/$(request.auth.uid);
      return isSignedIn() &&
        exists(staffPath) &&
        get(staffPath).data.status == 'active';
    }

    // التحقق من مساعد المنصة المفوض من أحد المالكين وصلاحيته المحددة
    function hasStaffPermission(permKey) {
      let staffPath = /databases/$(database)/documents/platform_staff/$(request.auth.uid);
      return isSignedIn() &&
        exists(staffPath) &&
        get(staffPath).data.status == 'active' &&
        get(staffPath).data.permissions[permKey] == true;
    }

    // التحقق من الحسابات الحالية القائمة قبل نظام التراخيص (Grandfathered Legacy Workspaces)
    // يعمل فقط عند عدم وجود وثيقة في /account_licenses/{wsId} بشرط أن تكون عضوية مالك المساحة نشطة (status == 'active')
    // وألا يحمل ملف المالك علامة طلب التسجيل المعلق أو المرفوض.
    function isLegacyGrandfatheredWorkspaceActive(wsId) {
      let wsPath = /databases/$(database)/documents/workspaces/$(wsId);
      let licPath = /databases/$(database)/documents/account_licenses/$(wsId);
      let wsOwnerId = get(wsPath).data.ownerId;
      let ownerMemberPath = /databases/$(database)/documents/workspace_members/$(wsId + '_' + wsOwnerId);
      let ownerUserPath = /databases/$(database)/documents/users/$(wsOwnerId);
      return isValidId(wsId) &&
        !exists(licPath) &&
        exists(wsPath) &&
        exists(ownerMemberPath) &&
        get(ownerMemberPath).data.role == 'owner' &&
        get(ownerMemberPath).data.status == 'active' &&
        (!exists(ownerUserPath) || !(get(ownerUserPath).data.jobTitle in [
          'طلب تسجيل جديد - بانتظار الموافقة',
          'طلب تسجيل مرفوض'
        ]));
    }

    // التحقق من سريان ترخيص العميل لمساحة العمل في المجموعة الموحدة /account_licenses/{wsId}
    // المالكان الدائمان (isAdmin / owner_permanent) والاشتراكات مدى الحياة (lifetime) معفيون من انتهاء الصلاحية،
    // كما تُحترم الحسابات الحالية القائمة قبل نظام التراخيص دون إجبارها على ترحيل قسري.
    function isWorkspaceLicenseActive(wsId) {
      let wsPath = /databases/$(database)/documents/workspaces/$(wsId);
      let licPath = /databases/$(database)/documents/account_licenses/$(wsId);
      return isAdmin() || (
        isValidId(wsId) &&
        exists(wsPath) && (
          (
            exists(licPath) &&
            get(licPath).data.status == 'active' && (
              isPermanentOwnerEmail(get(licPath).data.ownerEmail) ||
              get(licPath).data.planId in ['lifetime', 'owner_permanent'] ||
              get(licPath).data.expiresAt > request.time
            )
          ) ||
          isLegacyGrandfatheredWorkspaceActive(wsId)
        )
      );
    }

    // استخراج الحد الأقصى المسموح به لأعضاء الفريق في مساحة العمل حسب وثيقة الترخيص (أو 10 كحد أقصى افتراضي)
    function getWorkspaceMaxMembers(wsId) {
      let licPath = /databases/$(database)/documents/account_licenses/$(wsId);
      return isAdmin()
        ? 10
        : (exists(licPath) && get(licPath).data.maxMembers is number
            ? get(licPath).data.maxMembers
            : 10);
    }

    function isValidMemberUids(arr) {
      return arr is list &&
        arr.size() >= 1 &&
        arr.size() <= 10 &&
        arr[0] is string &&
        arr[0].size() >= 1 &&
        arr[0].size() <= 128;
    }

    // Master Gate: Workspace Membership & Ownership Verification (باستخدام ownerId و memberUids الفعليين)
    function isWorkspaceMember(wsId) {
      return isValidId(wsId) &&
        exists(/databases/$(database)/documents/workspaces/$(wsId)) &&
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(wsId)).data.memberUids;
    }

    function isWorkspaceOwner(wsId) {
      return isValidId(wsId) &&
        exists(/databases/$(database)/documents/workspaces/$(wsId)) &&
        get(/databases/$(database)/documents/workspaces/$(wsId)).data.ownerId == request.auth.uid;
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap) — محفوظة بالكامل من /firestore.rules

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.role is string && data.role.size() <= 40 && data.role in ['primary_owner', 'backup_owner'] &&
        data.createdAt is timestamp;
    }

    function isValidPlatformStaff(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'permissions', 'assignedByUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'permissions', 'assignedByUid', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        !isPermanentOwnerEmail(data.email) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.status is string && data.status.size() <= 20 && data.status in ['active', 'suspended'] &&
        data.permissions is map &&
        data.permissions.keys().hasAll(['canViewRequests', 'canApproveAndRenew', 'canManagePackages']) &&
        data.permissions.keys().hasOnly(['canViewRequests', 'canApproveAndRenew', 'canManagePackages']) &&
        data.permissions.canViewRequests is bool &&
        data.permissions.canApproveAndRenew is bool &&
        data.permissions.canManagePackages is bool &&
        isValidId(data.assignedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAccountLicense(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'ownerEmail', 'planId', 'status', 'startsAt', 'expiresAt', 'maxMembers', 'notes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'ownerEmail', 'planId', 'status', 'startsAt', 'expiresAt', 'maxMembers', 'notes', 'createdAt', 'updatedAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        data.ownerEmail is string && data.ownerEmail.size() >= 3 && data.ownerEmail.size() <= 200 &&
        data.planId is string && data.planId.size() >= 1 && data.planId.size() <= 64 &&
        data.planId in ['owner_permanent', 'lifetime', 'trial', 'monthly', 'quarterly', 'semi_annual', 'annual', 'custom'] &&
        data.status is string && data.status.size() <= 20 && data.status in ['pending', 'active', 'expired', 'suspended'] &&
        data.startsAt is timestamp &&
        data.expiresAt is timestamp &&
        data.expiresAt >= data.startsAt &&
        data.maxMembers is number && data.maxMembers >= 1 && data.maxMembers <= 10 &&
        data.notes is string && data.notes.size() <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubscriptionPackage(data) {
      return data.keys().hasAll(['nameAr', 'descriptionAr', 'billingCycle', 'durationDays', 'isLifetime', 'defaultMaxMembers', 'priceAmount', 'currency', 'isActive', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'nameAr', 'descriptionAr', 'billingCycle', 'durationDays', 'isLifetime', 'isFreeOwnerPlan', 'defaultMaxMembers', 'priceAmount', 'currency', 'isActive', 'createdAt', 'updatedAt']) &&
        (!('id' in data) || data.id in ['owner_permanent', 'lifetime', 'trial', 'monthly', 'quarterly', 'semi_annual', 'annual', 'custom']) &&
        data.nameAr is string && data.nameAr.size() >= 2 && data.nameAr.size() <= 120 &&
        data.descriptionAr is string && data.descriptionAr.size() >= 2 && data.descriptionAr.size() <= 500 &&
        data.billingCycle in ['monthly', 'quarterly', 'semi_annual', 'annual', 'lifetime', 'custom'] &&
        (data.durationDays == null || (data.durationDays is number && data.durationDays >= 1 && data.durationDays <= 36500)) &&
        data.isLifetime is bool &&
        data.defaultMaxMembers is number && data.defaultMaxMembers >= 1 && data.defaultMaxMembers <= 10 &&
        data.priceAmount is number && data.priceAmount >= 0 &&
        data.currency in ['YER', 'SAR', 'AED', 'EGP', 'JOD', 'IQD', 'KWD', 'OMR', 'QAR', 'BHD', 'USD'] &&
        data.isActive is bool &&
        data.updatedAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'phone', 'jobTitle', 'activeWorkspaceId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'jobTitle', 'activeWorkspaceId', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.jobTitle is string && data.jobTitle.size() <= 100 &&
        isValidId(data.activeWorkspaceId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll(['name', 'ownerId', 'ownerName', 'defaultCurrency', 'taxRatePercent', 'regionName', 'inviteCode', 'memberUids', 'memberCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'ownerId', 'ownerName', 'defaultCurrency', 'taxRatePercent', 'regionName', 'inviteCode', 'memberUids', 'memberCount', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidId(data.ownerId) &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120 &&
        data.defaultCurrency is string && data.defaultCurrency.size() >= 3 && data.defaultCurrency.size() <= 10 &&
        data.defaultCurrency in ['YER', 'SAR', 'AED', 'EGP', 'JOD', 'IQD', 'KWD', 'OMR', 'QAR', 'BHD', 'USD'] &&
        data.taxRatePercent is number && data.taxRatePercent >= 0 && data.taxRatePercent <= 100 &&
        data.regionName is string && data.regionName.size() <= 120 &&
        isValidId(data.inviteCode) && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 64 &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        data.memberCount is number && data.memberCount >= 1 && data.memberCount <= 10 &&
        data.memberCount == data.memberUids.size() &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspaceMember(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'userId', 'displayName', 'email', 'role', 'status', 'canApproveFinancials', 'canDeleteRecords', 'memberUids', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'userId', 'displayName', 'email', 'role', 'status', 'canApproveFinancials', 'canDeleteRecords', 'memberUids', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        isValidId(data.userId) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.role is string && data.role.size() <= 30 && data.role in ['owner', 'field_assistant', 'finance_assistant', 'viewer'] &&
        data.status is string && data.status.size() <= 20 && data.status in ['active', 'invited', 'suspended'] &&
        data.canApproveFinancials is bool &&
        data.canDeleteRecords is bool &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTaxpayer(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'fullName', 'internalCode', 'nationalOrCommercialId', 'phone', 'email', 'address', 'region', 'status', 'notes', 'memberUids', 'createdBy', 'createdByName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'fullName', 'internalCode', 'nationalOrCommercialId', 'phone', 'email', 'address', 'region', 'status', 'notes', 'memberUids', 'createdBy', 'createdByName', 'createdAt', 'updatedAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 150 &&
        data.internalCode is string && data.internalCode.size() >= 1 && data.internalCode.size() <= 64 &&
        data.nationalOrCommercialId is string && data.nationalOrCommercialId.size() <= 64 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.email is string && data.email.size() <= 200 &&
        data.address is string && data.address.size() <= 300 &&
        data.region is string && data.region.size() <= 120 &&
        data.status is string && data.status.size() <= 30 && data.status in ['active', 'under_review', 'archived'] &&
        data.notes is string && data.notes.size() <= 1000 &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        isValidId(data.createdBy) &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProperty(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'taxpayerId', 'taxpayerName', 'title', 'code', 'propertyType', 'status', 'region', 'address', 'latitude', 'longitude', 'hasCoordinates', 'unitsCount', 'areaSqm', 'notes', 'memberUids', 'createdBy', 'createdByName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'taxpayerId', 'taxpayerName', 'title', 'code', 'propertyType', 'status', 'region', 'address', 'latitude', 'longitude', 'hasCoordinates', 'unitsCount', 'areaSqm', 'notes', 'memberUids', 'createdBy', 'createdByName', 'createdAt', 'updatedAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        isValidId(data.taxpayerId) &&
        data.taxpayerName is string && data.taxpayerName.size() >= 1 && data.taxpayerName.size() <= 150 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 64 &&
        data.propertyType is string && data.propertyType.size() <= 30 && data.propertyType in ['residential', 'commercial', 'industrial', 'agricultural', 'mixed'] &&
        data.status is string && data.status.size() <= 30 && data.status in ['active', 'under_inspection', 'disputed', 'exempt', 'archived'] &&
        data.region is string && data.region.size() >= 1 && data.region.size() <= 120 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 300 &&
        data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
        data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
        data.hasCoordinates is bool &&
        data.unitsCount is number && data.unitsCount >= 0 && data.unitsCount <= 10000 &&
        data.areaSqm is number && data.areaSqm >= 0 && data.areaSqm <= 10000000 &&
        data.notes is string && data.notes.size() <= 1000 &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        isValidId(data.createdBy) &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPropertyUnit(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'propertyId', 'propertyTitle', 'taxpayerId', 'unitNumber', 'unitType', 'floor', 'areaSqm', 'occupancyStatus', 'tenantName', 'annualRentEstimate', 'notes', 'memberUids', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'propertyId', 'propertyTitle', 'taxpayerId', 'unitNumber', 'unitType', 'floor', 'areaSqm', 'occupancyStatus', 'tenantName', 'annualRentEstimate', 'notes', 'memberUids', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        isValidId(data.propertyId) &&
        data.propertyTitle is string && data.propertyTitle.size() >= 1 && data.propertyTitle.size() <= 150 &&
        isValidId(data.taxpayerId) &&
        data.unitNumber is string && data.unitNumber.size() >= 1 && data.unitNumber.size() <= 50 &&
        data.unitType is string && data.unitType.size() <= 30 && data.unitType in ['apartment', 'shop', 'office', 'warehouse', 'other'] &&
        data.floor is string && data.floor.size() <= 40 &&
        data.areaSqm is number && data.areaSqm >= 0 && data.areaSqm <= 1000000 &&
        data.occupancyStatus is string && data.occupancyStatus.size() <= 30 && data.occupancyStatus in ['occupied', 'vacant', 'under_maintenance'] &&
        data.tenantName is string && data.tenantName.size() <= 150 &&
        data.annualRentEstimate is number && data.annualRentEstimate >= 0 &&
        data.notes is string && data.notes.size() <= 500 &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFieldVisit(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'propertyId', 'propertyTitle', 'taxpayerId', 'taxpayerName', 'visitDate', 'visitTime', 'purpose', 'status', 'latitude', 'longitude', 'hasCoordinates', 'photoSummary', 'notes', 'memberUids', 'officerId', 'officerName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'propertyId', 'propertyTitle', 'taxpayerId', 'taxpayerName', 'visitDate', 'visitTime', 'purpose', 'status', 'latitude', 'longitude', 'hasCoordinates', 'photoSummary', 'notes', 'memberUids', 'officerId', 'officerName', 'createdAt', 'updatedAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        isValidId(data.propertyId) &&
        data.propertyTitle is string && data.propertyTitle.size() >= 1 && data.propertyTitle.size() <= 150 &&
        isValidId(data.taxpayerId) &&
        data.taxpayerName is string && data.taxpayerName.size() >= 1 && data.taxpayerName.size() <= 150 &&
        data.visitDate is string && data.visitDate.size() >= 8 && data.visitDate.size() <= 40 &&
        data.visitTime is string && data.visitTime.size() >= 3 && data.visitTime.size() <= 20 &&
        data.purpose is string && data.purpose.size() <= 40 && data.purpose in ['initial_survey', 'periodic_inspection', 'valuation_verify', 'collection_followup', 'dispute_check'] &&
        data.status is string && data.status.size() <= 40 && data.status in ['completed', 'requires_followup', 'occupant_absent', 'access_denied'] &&
        data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
        data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
        data.hasCoordinates is bool &&
        data.photoSummary is string && data.photoSummary.size() <= 500 &&
        data.notes is string && data.notes.size() <= 1500 &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        isValidId(data.officerId) &&
        data.officerName is string && data.officerName.size() >= 1 && data.officerName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'title', 'propertyId', 'propertyTitle', 'taxpayerId', 'taxpayerName', 'scheduledDate', 'scheduledTime', 'locationText', 'status', 'postponeCount', 'lastPostponeReason', 'notes', 'memberUids', 'createdBy', 'createdByName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'title', 'propertyId', 'propertyTitle', 'taxpayerId', 'taxpayerName', 'scheduledDate', 'scheduledTime', 'locationText', 'status', 'postponeCount', 'lastPostponeReason', 'notes', 'memberUids', 'createdBy', 'createdByName', 'createdAt', 'updatedAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
        isValidId(data.propertyId) &&
        data.propertyTitle is string && data.propertyTitle.size() >= 1 && data.propertyTitle.size() <= 150 &&
        isValidId(data.taxpayerId) &&
        data.taxpayerName is string && data.taxpayerName.size() >= 1 && data.taxpayerName.size() <= 150 &&
        data.scheduledDate is string && data.scheduledDate.size() >= 8 && data.scheduledDate.size() <= 40 &&
        data.scheduledTime is string && data.scheduledTime.size() >= 3 && data.scheduledTime.size() <= 20 &&
        data.locationText is string && data.locationText.size() <= 250 &&
        data.status is string && data.status.size() <= 30 && data.status in ['upcoming', 'postponed', 'completed', 'cancelled'] &&
        data.postponeCount is number && data.postponeCount >= 0 && data.postponeCount <= 100 &&
        data.lastPostponeReason is string && data.lastPostponeReason.size() <= 500 &&
        data.notes is string && data.notes.size() <= 1000 &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        isValidId(data.createdBy) &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAppointmentPostponement(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'appointmentId', 'previousDate', 'previousTime', 'newDate', 'newTime', 'reason', 'memberUids', 'createdBy', 'createdByName', 'createdAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'appointmentId', 'previousDate', 'previousTime', 'newDate', 'newTime', 'reason', 'memberUids', 'createdBy', 'createdByName', 'createdAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        isValidId(data.appointmentId) &&
        data.previousDate is string && data.previousDate.size() >= 8 && data.previousDate.size() <= 40 &&
        data.previousTime is string && data.previousTime.size() >= 3 && data.previousTime.size() <= 20 &&
        data.newDate is string && data.newDate.size() >= 8 && data.newDate.size() <= 40 &&
        data.newTime is string && data.newTime.size() >= 3 && data.newTime.size() <= 20 &&
        data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 500 &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        isValidId(data.createdBy) &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidFinancialAssessment(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'propertyId', 'propertyTitle', 'taxpayerId', 'taxpayerName', 'amount', 'currency', 'periodLabel', 'assessmentDate', 'status', 'notes', 'memberUids', 'createdBy', 'createdByName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'propertyId', 'propertyTitle', 'taxpayerId', 'taxpayerName', 'amount', 'currency', 'periodLabel', 'assessmentDate', 'status', 'notes', 'memberUids', 'createdBy', 'createdByName', 'createdAt', 'updatedAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        isValidId(data.propertyId) &&
        data.propertyTitle is string && data.propertyTitle.size() >= 1 && data.propertyTitle.size() <= 150 &&
        isValidId(data.taxpayerId) &&
        data.taxpayerName is string && data.taxpayerName.size() >= 1 && data.taxpayerName.size() <= 150 &&
        data.amount is number && data.amount >= 0 &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        data.periodLabel is string && data.periodLabel.size() >= 2 && data.periodLabel.size() <= 80 &&
        data.assessmentDate is string && data.assessmentDate.size() >= 8 && data.assessmentDate.size() <= 40 &&
        data.status is string && data.status.size() <= 30 && data.status in ['draft', 'approved', 'cancelled'] &&
        data.notes is string && data.notes.size() <= 1000 &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        isValidId(data.createdBy) &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFinancialTransaction(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'propertyId', 'propertyTitle', 'taxpayerId', 'taxpayerName', 'assessmentId', 'transactionType', 'amount', 'currency', 'transactionDate', 'referenceNumber', 'status', 'notes', 'memberUids', 'createdBy', 'createdByName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'propertyId', 'propertyTitle', 'taxpayerId', 'taxpayerName', 'assessmentId', 'transactionType', 'amount', 'currency', 'transactionDate', 'referenceNumber', 'status', 'notes', 'memberUids', 'createdBy', 'createdByName', 'createdAt', 'updatedAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        isValidId(data.propertyId) &&
        data.propertyTitle is string && data.propertyTitle.size() >= 1 && data.propertyTitle.size() <= 150 &&
        isValidId(data.taxpayerId) &&
        data.taxpayerName is string && data.taxpayerName.size() >= 1 && data.taxpayerName.size() <= 150 &&
        isValidId(data.assessmentId) &&
        data.transactionType is string && data.transactionType.size() <= 30 && data.transactionType in ['payment', 'fee', 'adjustment', 'reversal'] &&
        data.amount is number && data.amount >= 0 &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        data.transactionDate is string && data.transactionDate.size() >= 8 && data.transactionDate.size() <= 40 &&
        data.referenceNumber is string && data.referenceNumber.size() >= 1 && data.referenceNumber.size() <= 80 &&
        data.status is string && data.status.size() <= 30 && data.status in ['pending', 'approved', 'reversed'] &&
        data.notes is string && data.notes.size() <= 1000 &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        isValidId(data.createdBy) &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotificationItem(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'title', 'message', 'category', 'isRead', 'memberUids', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'title', 'message', 'category', 'isRead', 'memberUids', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        data.category is string && data.category.size() <= 30 && data.category in ['appointment', 'visit', 'finance', 'team', 'system'] &&
        data.isRead is bool &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId', 'actionType', 'entityType', 'entityId', 'summary', 'actorId', 'actorName', 'memberUids', 'createdAt']) &&
        data.keys().hasOnly(['workspaceId', 'ownerId', 'actionType', 'entityType', 'entityId', 'summary', 'actorId', 'actorName', 'memberUids', 'createdAt']) &&
        isValidId(data.workspaceId) &&
        isValidId(data.ownerId) &&
        data.actionType is string && data.actionType.size() <= 30 && data.actionType in ['create', 'update', 'delete', 'approve', 'reverse', 'postpone', 'team_change', 'voice_command'] &&
        data.entityType is string && data.entityType.size() <= 30 && data.entityType in ['taxpayer', 'property', 'unit', 'visit', 'appointment', 'assessment', 'transaction', 'member', 'workspace'] &&
        isValidId(data.entityId) &&
        data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 500 &&
        isValidId(data.actorId) &&
        data.actorId == request.auth.uid &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120 &&
        isValidMemberUids(data.memberUids) &&
        data.ownerId in data.memberUids &&
        data.createdAt is timestamp;
    }

    // 4. Collection Match Blocks

    // Collection 0A: /admins/{adminUid} (سجلات المالكين الإداريين)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if false;
      allow create: if isAdmin() && isValidId(adminUid) && isValidAdminRecord(incoming()) && incoming().uid == adminUid;
      allow update: if isAdmin() && isValidId(adminUid) && isValidAdminRecord(incoming()) && incoming().uid == existing().uid;
      allow delete: if isAdmin() && isValidId(adminUid);
    }

    // Collection 0B: /platform_staff/{staffUid} (مساعدو إدارة المنصة — التعيين وتحديد الصلاحيات حصري للمالكين الدائمين)
    match /platform_staff/{staffUid} {
      allow get: if isSignedIn() && isValidId(staffUid) && (request.auth.uid == staffUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(staffUid) &&
        isValidPlatformStaff(incoming()) &&
        incoming().uid == staffUid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(staffUid) &&
        isValidPlatformStaff(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(staffUid);
    }

    // Collection 0C: /account_licenses/{workspaceId} (المجموعة الموحدة لتراخيص واشتراكات الحسابات)
    match /account_licenses/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && (
        resource == null ||
        workspaceId == 'ws_' + request.auth.uid ||
        (resource != null && existing().ownerId == request.auth.uid) ||
        isWorkspaceMember(workspaceId) ||
        isWorkspaceOwner(workspaceId) ||
        isAdmin() ||
        hasStaffPermission('canViewRequests') ||
        hasStaffPermission('canApproveAndRenew')
      );
      allow list: if isSignedIn() && (
        existing().ownerId == request.auth.uid ||
        isAdmin() ||
        hasStaffPermission('canViewRequests') ||
        hasStaffPermission('canApproveAndRenew')
      );
      // يسمح للعميل الجديد بإنشاء طلب ترخيص بحالة pending فقط ومرتبط بـ ownerId وبريده الموثق دون تفعيل نفسه أو طلب باقة المالك،
      // كما يسمح لمساعد المنصة المفوض (canApproveAndRenew) بإصدار وثيقة ترخيص لحساب عميل قائم سابقًا (Grandfathered) غير معلق.
      allow create: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidAccountLicense(incoming()) &&
        incoming().workspaceId == workspaceId && (
          isAdmin() || (
            incoming().ownerId == request.auth.uid &&
            matchesAuthTokenEmailOrMissing(incoming().ownerEmail) &&
            !isPermanentOwnerEmail(incoming().ownerEmail) &&
            incoming().planId != 'owner_permanent' &&
            incoming().status == 'pending' &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time
          ) || (
            hasStaffPermission('canApproveAndRenew') &&
            isLegacyGrandfatheredWorkspaceActive(workspaceId) &&
            !isPermanentOwnerEmail(incoming().ownerEmail) &&
            incoming().planId != 'owner_permanent' &&
            incoming().status in ['active', 'suspended'] &&
            incoming().ownerId == get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidAccountLicense(incoming()) && (
          isAdmin() || (
            // السماح لصاحب الطلب المعلق بتحديث ملاحظات بيانات طلبه الوصفية فقط مع بقاء الحالة pending وجميع الحقول الأمنية ثابتة
            existing().ownerId == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            !isPermanentOwnerEmail(existing().ownerEmail) &&
            !isPermanentOwnerEmail(incoming().ownerEmail) &&
            existing().planId != 'owner_permanent' &&
            incoming().planId == existing().planId &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().ownerEmail == existing().ownerEmail &&
            incoming().maxMembers == existing().maxMembers &&
            incoming().startsAt == existing().startsAt &&
            incoming().expiresAt == existing().expiresAt &&
            (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'createdAt', 'updatedAt'])
          ) || (
            // قبول أو رفض طلب التسجيل الأولي (existing().status == 'pending') حصري للمالكين الدائمين (isAdmin) فقط
            hasStaffPermission('canApproveAndRenew') &&
            existing().status != 'pending' &&
            incoming().status != 'pending' &&
            !isPermanentOwnerEmail(existing().ownerEmail) &&
            existing().planId != 'owner_permanent' &&
            incoming().planId != 'owner_permanent' &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().ownerEmail == existing().ownerEmail &&
            (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['planId', 'status', 'startsAt', 'expiresAt', 'maxMembers', 'notes', 'createdAt', 'updatedAt']) &&
            (
              (incoming().planId == existing().planId && incoming().maxMembers == existing().maxMembers) ||
              hasStaffPermission('canManagePackages')
            )
          )
        );
      allow delete: if isAdmin() && isValidId(workspaceId);
    }

    // Collection 0D: /subscription_packages/{packageId} (باقات الاشتراك ومددها وحدود أعضاء الفريق)
    match /subscription_packages/{packageId} {
      allow get, list: if isSignedIn();
      allow create, update: if isVerifiedUser() &&
        isValidId(packageId) &&
        packageId != 'owner_permanent' &&
        isValidSubscriptionPackage(incoming()) &&
        (!('id' in incoming()) || incoming().id == packageId) &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          hasStaffPermission('canManagePackages')
        );
      allow delete: if isAdmin() && isValidId(packageId) && packageId != 'owner_permanent';
    }

    // Collection 1: /users/{userId} (PII strictly isolated to owner, workspace owner binding, or admin)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId ||
        isAdmin() ||
        hasStaffPermission('canViewRequests') ||
        hasStaffPermission('canApproveAndRenew')
      );
      allow list: if isSignedIn() && (
        existing().uid == request.auth.uid ||
        isAdmin() ||
        hasStaffPermission('canViewRequests') ||
        hasStaffPermission('canApproveAndRenew')
      );
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == userId &&
        (!isPermanentOwnerEmail(incoming().email) || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (userId == request.auth.uid && matchesAuthTokenEmailOrMissing(incoming().email)) ||
          isWorkspaceOwner(incoming().activeWorkspaceId) ||
          isAdmin()
        );
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUser(incoming()) && (
          isAdmin() || (
            (request.auth.uid == userId || isWorkspaceOwner(incoming().activeWorkspaceId)) &&
            incoming().uid == existing().uid &&
            incoming().email == existing().email &&
            (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'phone', 'jobTitle', 'activeWorkspaceId', 'createdAt', 'updatedAt']) &&
            (
              !(existing().jobTitle in ['طلب تسجيل جديد - بانتظار الموافقة', 'طلب تسجيل مرفوض']) ||
              incoming().jobTitle == existing().jobTitle ||
              isWorkspaceLicenseActive(existing().activeWorkspaceId)
            )
          )
        );
      allow delete: if isAdmin();
    }

    // Collection 2: /workspaces/{workspaceId}
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && (
        resource == null ||
        workspaceId == 'ws_' + request.auth.uid ||
        (resource != null && (request.auth.uid in existing().memberUids || existing().ownerId == request.auth.uid)) ||
        isAdmin() ||
        hasStaffPermission('canViewRequests') ||
        hasStaffPermission('canApproveAndRenew')
      );
      allow list: if isSignedIn() && (
        request.auth.uid in existing().memberUids ||
        existing().ownerId == request.auth.uid ||
        isAdmin() ||
        hasStaffPermission('canViewRequests') ||
        hasStaffPermission('canApproveAndRenew')
      );
      allow create: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidWorkspace(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        request.auth.uid in incoming().memberUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidWorkspace(incoming()) && (
          isAdmin() || (
            isWorkspaceLicenseActive(workspaceId) &&
            existing().ownerId == request.auth.uid &&
            incoming().ownerId == existing().ownerId &&
            (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
            incoming().updatedAt == request.time &&
            request.auth.uid in incoming().memberUids &&
            (incoming().memberUids.size() <= getWorkspaceMaxMembers(workspaceId) || incoming().memberUids.size() <= existing().memberUids.size()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'ownerName', 'defaultCurrency', 'taxRatePercent', 'regionName', 'inviteCode', 'memberUids', 'memberCount', 'createdAt', 'updatedAt'])
          ) || (
            // Action 2: Invited member links their UID into workspace memberUids
            isWorkspaceLicenseActive(workspaceId) &&
            incoming().ownerId == existing().ownerId &&
            incoming().name == existing().name &&
            incoming().ownerName == existing().ownerName &&
            incoming().defaultCurrency == existing().defaultCurrency &&
            incoming().taxRatePercent == existing().taxRatePercent &&
            incoming().regionName == existing().regionName &&
            incoming().inviteCode == existing().inviteCode &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            request.auth.uid in incoming().memberUids &&
            (incoming().memberUids.size() <= getWorkspaceMaxMembers(workspaceId) || incoming().memberUids.size() <= existing().memberUids.size()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt'])
          )
        );
      allow delete: if isAdmin();
    }

    // Collection 3: /workspace_members/{memberId}
    match /workspace_members/{memberId} {
      allow get: if isSignedIn() && isValidId(memberId) && (
        resource == null ||
        memberId == 'ws_' + request.auth.uid + '_' + request.auth.uid ||
        isAdmin() ||
        hasStaffPermission('canViewRequests') ||
        hasStaffPermission('canApproveAndRenew') ||
        (resource != null && (
          request.auth.uid in existing().memberUids ||
          existing().userId == request.auth.uid ||
          existing().ownerId == request.auth.uid ||
          matchesAuthTokenEmail(existing().email)
        ))
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        hasStaffPermission('canViewRequests') ||
        hasStaffPermission('canApproveAndRenew') ||
        request.auth.uid in existing().memberUids ||
        existing().userId == request.auth.uid ||
        existing().ownerId == request.auth.uid ||
        matchesAuthTokenEmail(existing().email)
      );
      allow create: if isVerifiedUser() &&
        isValidId(memberId) &&
        isValidWorkspaceMember(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().memberUids.size() <= getWorkspaceMaxMembers(incoming().workspaceId) && (
          (
            incoming().ownerId == request.auth.uid &&
            incoming().userId == request.auth.uid &&
            incoming().role == 'owner' &&
            request.auth.uid in incoming().memberUids &&
            (incoming().status == 'invited' || isAdmin() || isWorkspaceLicenseActive(incoming().workspaceId))
          ) ||
          (isWorkspaceLicenseActive(incoming().workspaceId) && isWorkspaceOwner(incoming().workspaceId) && incoming().role != 'owner') ||
          isAdmin() ||
          (isWorkspaceLicenseActive(incoming().workspaceId) && incoming().userId == request.auth.uid && incoming().role != 'owner' && isWorkspaceMember(incoming().workspaceId))
        );
      allow update: if isVerifiedUser() &&
        isValidId(memberId) &&
        isValidWorkspaceMember(incoming()) && (
          isAdmin() || (
            // Action 1: Owner updates assistant member role, permissions, status, or memberUids (cannot self-activate own owner status)
            isWorkspaceLicenseActive(existing().workspaceId) &&
            (existing().ownerId == request.auth.uid || isWorkspaceOwner(existing().workspaceId)) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            (existing().userId != existing().ownerId || incoming().status == existing().status) &&
            (incoming().role != 'owner' || existing().role == 'owner') &&
            (incoming().memberUids.size() <= getWorkspaceMaxMembers(existing().workspaceId) || incoming().memberUids.size() <= existing().memberUids.size()) &&
            (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'displayName', 'email', 'role', 'status', 'canApproveFinancials', 'canDeleteRecords', 'memberUids', 'createdAt', 'updatedAt'])
          ) || (
            // Action 2: Invited team assistant (role != 'owner') activates their own membership record
            isWorkspaceLicenseActive(existing().workspaceId) &&
            existing().role != 'owner' &&
            existing().status == 'invited' &&
            matchesAuthTokenEmail(existing().email) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().role == existing().role &&
            incoming().canApproveFinancials == existing().canApproveFinancials &&
            incoming().canDeleteRecords == existing().canDeleteRecords &&
            incoming().userId == request.auth.uid &&
            incoming().status == 'active' &&
            (incoming().memberUids.size() <= getWorkspaceMaxMembers(existing().workspaceId) || incoming().memberUids.size() <= existing().memberUids.size()) &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'displayName', 'status', 'memberUids', 'updatedAt'])
          ) || (
            // Action 3: Platform Staff with canApproveAndRenew syncs workspace owner status during subscription suspension/reactivation (never initial pending 'invited')
            hasStaffPermission('canApproveAndRenew') &&
            existing().role == 'owner' &&
            existing().userId == existing().ownerId &&
            existing().status != 'invited' &&
            !isPermanentOwnerEmail(existing().email) &&
            incoming().status in ['active', 'suspended'] &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(memberId) && (
        (isWorkspaceLicenseActive(existing().workspaceId) && isWorkspaceOwner(existing().workspaceId)) ||
        isAdmin() ||
        (matchesAuthTokenEmail(existing().email) && existing().status == 'invited')
      );
    }

    // Collection 4: /taxpayers/{taxpayerId}
    // عند انتهاء الاشتراك أو الإيقاف: تبقى القراءة (get, list) متاحة لأعضاء المساحة لحفظ البيانات، وتتوقف الكتابة
    match /taxpayers/{taxpayerId} {
      allow get: if isSignedIn() && isValidId(taxpayerId) && resource != null && (request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(taxpayerId) &&
        isValidTaxpayer(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        request.auth.uid in incoming().memberUids &&
        isWorkspaceMember(incoming().workspaceId) &&
        isWorkspaceLicenseActive(incoming().workspaceId);
      allow update: if isVerifiedUser() &&
        isValidId(taxpayerId) &&
        isValidTaxpayer(incoming()) && (
          isAdmin() || (
            isWorkspaceLicenseActive(existing().workspaceId) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdBy == existing().createdBy &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            isWorkspaceMember(existing().workspaceId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'internalCode', 'nationalOrCommercialId', 'phone', 'email', 'address', 'region', 'status', 'notes', 'memberUids', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(taxpayerId) && (
        (isWorkspaceLicenseActive(existing().workspaceId) && isWorkspaceOwner(existing().workspaceId)) ||
        isAdmin()
      );
    }

    // Collection 5: /properties/{propertyId}
    match /properties/{propertyId} {
      allow get: if isSignedIn() && isValidId(propertyId) && resource != null && (request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(propertyId) &&
        isValidProperty(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        request.auth.uid in incoming().memberUids &&
        isWorkspaceMember(incoming().workspaceId) &&
        isWorkspaceLicenseActive(incoming().workspaceId) &&
        exists(/databases/$(database)/documents/taxpayers/$(incoming().taxpayerId)) &&
        get(/databases/$(database)/documents/taxpayers/$(incoming().taxpayerId)).data.workspaceId == incoming().workspaceId;
      allow update: if isVerifiedUser() &&
        isValidId(propertyId) &&
        isValidProperty(incoming()) && (
          isAdmin() || (
            isWorkspaceLicenseActive(existing().workspaceId) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdBy == existing().createdBy &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            isWorkspaceMember(existing().workspaceId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['taxpayerId', 'taxpayerName', 'title', 'code', 'propertyType', 'status', 'region', 'address', 'latitude', 'longitude', 'hasCoordinates', 'unitsCount', 'areaSqm', 'notes', 'memberUids', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(propertyId) && (
        (isWorkspaceLicenseActive(existing().workspaceId) && isWorkspaceOwner(existing().workspaceId)) ||
        isAdmin()
      );
    }

    // Collection 6: /property_units/{unitId}
    match /property_units/{unitId} {
      allow get: if isSignedIn() && isValidId(unitId) && resource != null && (request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(unitId) &&
        isValidPropertyUnit(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        request.auth.uid in incoming().memberUids &&
        isWorkspaceMember(incoming().workspaceId) &&
        isWorkspaceLicenseActive(incoming().workspaceId) &&
        exists(/databases/$(database)/documents/properties/$(incoming().propertyId)) &&
        get(/databases/$(database)/documents/properties/$(incoming().propertyId)).data.workspaceId == incoming().workspaceId;
      allow update: if isVerifiedUser() &&
        isValidId(unitId) &&
        isValidPropertyUnit(incoming()) && (
          isAdmin() || (
            isWorkspaceLicenseActive(existing().workspaceId) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().propertyId == existing().propertyId &&
            incoming().createdBy == existing().createdBy &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            isWorkspaceMember(existing().workspaceId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['propertyTitle', 'unitNumber', 'unitType', 'floor', 'areaSqm', 'occupancyStatus', 'tenantName', 'annualRentEstimate', 'notes', 'memberUids', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(unitId) && (
        (isWorkspaceLicenseActive(existing().workspaceId) && isWorkspaceOwner(existing().workspaceId)) ||
        isAdmin()
      );
    }

    // Collection 7: /field_visits/{visitId}
    match /field_visits/{visitId} {
      allow get: if isSignedIn() && isValidId(visitId) && resource != null && (request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(visitId) &&
        isValidFieldVisit(incoming()) &&
        incoming().officerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        request.auth.uid in incoming().memberUids &&
        isWorkspaceMember(incoming().workspaceId) &&
        isWorkspaceLicenseActive(incoming().workspaceId) && (
          (incoming().propertyId == 'general_prop' &&
           exists(/databases/$(database)/documents/taxpayers/$(incoming().taxpayerId)) &&
           get(/databases/$(database)/documents/taxpayers/$(incoming().taxpayerId)).data.workspaceId == incoming().workspaceId) ||
          (exists(/databases/$(database)/documents/properties/$(incoming().propertyId)) &&
           get(/databases/$(database)/documents/properties/$(incoming().propertyId)).data.workspaceId == incoming().workspaceId)
        );
      allow update: if isVerifiedUser() &&
        isValidId(visitId) &&
        isValidFieldVisit(incoming()) && (
          isAdmin() || (
            isWorkspaceLicenseActive(existing().workspaceId) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().propertyId == existing().propertyId &&
            incoming().officerId == existing().officerId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            isWorkspaceMember(existing().workspaceId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['visitDate', 'visitTime', 'purpose', 'status', 'latitude', 'longitude', 'hasCoordinates', 'photoSummary', 'notes', 'memberUids', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(visitId) && (
        (isWorkspaceLicenseActive(existing().workspaceId) && isWorkspaceOwner(existing().workspaceId)) ||
        isAdmin()
      );
    }

    // Collection 8: /appointments/{appointmentId}
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && isValidId(appointmentId) && resource != null && (request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(appointmentId) &&
        isValidAppointment(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        request.auth.uid in incoming().memberUids &&
        isWorkspaceMember(incoming().workspaceId) &&
        isWorkspaceLicenseActive(incoming().workspaceId);
      allow update: if isVerifiedUser() &&
        isValidId(appointmentId) &&
        isValidAppointment(incoming()) && (
          isAdmin() || (
            isWorkspaceLicenseActive(existing().workspaceId) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdBy == existing().createdBy &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            isWorkspaceMember(existing().workspaceId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'scheduledDate', 'scheduledTime', 'locationText', 'status', 'postponeCount', 'lastPostponeReason', 'notes', 'memberUids', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(appointmentId) && (
        (isWorkspaceLicenseActive(existing().workspaceId) && isWorkspaceOwner(existing().workspaceId)) ||
        isAdmin()
      );
    }

    // Collection 9: /appointment_postponements/{postponementId} (Append-Only History)
    match /appointment_postponements/{postponementId} {
      allow get: if isSignedIn() && isValidId(postponementId) && resource != null && (request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(postponementId) &&
        isValidAppointmentPostponement(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        request.auth.uid in incoming().memberUids &&
        isWorkspaceMember(incoming().workspaceId) &&
        isWorkspaceLicenseActive(incoming().workspaceId) &&
        exists(/databases/$(database)/documents/appointments/$(incoming().appointmentId)) &&
        get(/databases/$(database)/documents/appointments/$(incoming().appointmentId)).data.workspaceId == incoming().workspaceId;
      allow update, delete: if false;
    }

    // Collection 10: /financial_assessments/{assessmentId} (Terminal State Locking on Approved/Cancelled)
    match /financial_assessments/{assessmentId} {
      allow get: if isSignedIn() && isValidId(assessmentId) && resource != null && (request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(assessmentId) &&
        isValidFinancialAssessment(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        request.auth.uid in incoming().memberUids &&
        isWorkspaceMember(incoming().workspaceId) &&
        isWorkspaceLicenseActive(incoming().workspaceId) && (
          (incoming().propertyId == 'general_prop' &&
           exists(/databases/$(database)/documents/taxpayers/$(incoming().taxpayerId)) &&
           get(/databases/$(database)/documents/taxpayers/$(incoming().taxpayerId)).data.workspaceId == incoming().workspaceId) ||
          (exists(/databases/$(database)/documents/properties/$(incoming().propertyId)) &&
           get(/databases/$(database)/documents/properties/$(incoming().propertyId)).data.workspaceId == incoming().workspaceId)
        );
      allow update: if isVerifiedUser() &&
        isValidId(assessmentId) &&
        isValidFinancialAssessment(incoming()) && (
          isAdmin() || (
            // Action 1: Update draft assessment (only while in 'draft' state and license active)
            isWorkspaceLicenseActive(existing().workspaceId) &&
            existing().status == 'draft' &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().propertyId == existing().propertyId &&
            incoming().taxpayerId == existing().taxpayerId &&
            incoming().createdBy == existing().createdBy &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            isWorkspaceMember(existing().workspaceId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'currency', 'periodLabel', 'assessmentDate', 'status', 'notes', 'memberUids', 'updatedAt'])
          ) || (
            // Action 2: Owner can cancel an approved assessment or sync memberUids while license active
            isWorkspaceLicenseActive(existing().workspaceId) &&
            isWorkspaceOwner(existing().workspaceId) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdBy == existing().createdBy &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'memberUids', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(assessmentId) && existing().status == 'draft' && (
        (isWorkspaceLicenseActive(existing().workspaceId) && isWorkspaceOwner(existing().workspaceId)) ||
        isAdmin()
      );
    }

    // Collection 11: /financial_transactions/{transactionId} (Terminal State Locking on Reversed/Approved)
    match /financial_transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && resource != null && (request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(transactionId) &&
        isValidFinancialTransaction(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        request.auth.uid in incoming().memberUids &&
        isWorkspaceMember(incoming().workspaceId) &&
        isWorkspaceLicenseActive(incoming().workspaceId) && (
          (incoming().propertyId == 'general_prop' &&
           exists(/databases/$(database)/documents/taxpayers/$(incoming().taxpayerId)) &&
           get(/databases/$(database)/documents/taxpayers/$(incoming().taxpayerId)).data.workspaceId == incoming().workspaceId) ||
          (exists(/databases/$(database)/documents/properties/$(incoming().propertyId)) &&
           get(/databases/$(database)/documents/properties/$(incoming().propertyId)).data.workspaceId == incoming().workspaceId)
        );
      allow update: if isVerifiedUser() &&
        isValidId(transactionId) &&
        isValidFinancialTransaction(incoming()) && (
          isAdmin() || (
            // Action 1: Owner approves or reverses a transaction while license active
            isWorkspaceLicenseActive(existing().workspaceId) &&
            existing().status != 'reversed' &&
            isWorkspaceOwner(existing().workspaceId) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().amount == existing().amount &&
            incoming().createdBy == existing().createdBy &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'memberUids', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // Collection 12: /notifications/{notificationId}
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && resource != null && (request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotificationItem(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        request.auth.uid in incoming().memberUids &&
        isWorkspaceMember(incoming().workspaceId) &&
        isWorkspaceLicenseActive(incoming().workspaceId);
      allow update: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotificationItem(incoming()) && (
          isAdmin() || (
            isWorkspaceLicenseActive(existing().workspaceId) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdBy == existing().createdBy &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            isWorkspaceMember(existing().workspaceId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'memberUids', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(notificationId) && (
        (isWorkspaceLicenseActive(existing().workspaceId) && isWorkspaceOwner(existing().workspaceId)) ||
        isAdmin()
      );
    }

    // Collection 13: /audit_logs/{logId} (Strictly Immutable Append-Only Audit Trail)
    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && resource != null && (
        request.auth.uid in existing().memberUids ||
        isAdmin() ||
        hasStaffPermission('canViewRequests') ||
        hasStaffPermission('canApproveAndRenew') ||
        hasStaffPermission('canManagePackages')
      );
      allow list: if isSignedIn() && (
        request.auth.uid in existing().memberUids ||
        isAdmin() ||
        hasStaffPermission('canViewRequests') ||
        hasStaffPermission('canApproveAndRenew') ||
        hasStaffPermission('canManagePackages')
      );
      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().actorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        request.auth.uid in incoming().memberUids && (
          isAdmin() ||
          isActivePlatformStaff() ||
          (isWorkspaceMember(incoming().workspaceId) && isWorkspaceLicenseActive(incoming().workspaceId))
        );
      allow update, delete: if false;
    }
  }
}
