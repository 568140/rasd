{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private user account profile and active workspace binding",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Full Arabic or English display name",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "description": "Optional phone number",
          "maxLength": 40
        },
        "jobTitle": {
          "type": "string",
          "description": "Field officer title or role label",
          "maxLength": 100
        },
        "activeWorkspaceId": {
          "type": "string",
          "description": "Currently active workspace ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "displayName", "email", "activeWorkspaceId", "createdAt", "updatedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Independent field workspace owned by a single owner with up to 9 assistants (max 10 members total)",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Workspace name",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the workspace owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "description": "Display name of workspace owner",
          "minLength": 1,
          "maxLength": 120
        },
        "defaultCurrency": {
          "type": "string",
          "description": "Default currency code for financial records",
          "enum": ["YER", "SAR", "AED", "EGP", "JOD", "IQD", "KWD", "OMR", "QAR", "BHD", "USD"],
          "minLength": 3,
          "maxLength": 10
        },
        "taxRatePercent": {
          "type": "number",
          "description": "Configurable assessment rate percentage (0 if not used)"
        },
        "regionName": {
          "type": "string",
          "description": "Default operating geographic region",
          "maxLength": 120
        },
        "inviteCode": {
          "type": "string",
          "description": "Workspace invitation token managed by owner",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array",
          "description": "Bounded list of up to 10 member UIDs including owner"
        },
        "memberCount": {
          "type": "number",
          "description": "Total active members count (1 to 10)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["name", "ownerId", "ownerName", "defaultCurrency", "taxRatePercent", "regionName", "inviteCode", "memberUids", "memberCount", "createdAt", "updatedAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Membership record linking a user or invited assistant to a workspace with explicit role and granular permissions",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "Target workspace ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the workspace owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Member UID or invited placeholder ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Member full name",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "description": "Member email address",
          "minLength": 3,
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "description": "Member role in the workspace",
          "enum": ["owner", "field_assistant", "finance_assistant", "viewer"]
        },
        "status": {
          "type": "string",
          "description": "Membership status",
          "enum": ["active", "invited", "suspended"]
        },
        "canApproveFinancials": {
          "type": "boolean",
          "description": "Whether member can approve financial assessments or transactions"
        },
        "canDeleteRecords": {
          "type": "boolean",
          "description": "Whether member can delete records"
        },
        "memberUids": {
          "type": "array",
          "description": "Bounded list of workspace member UIDs for secure list query enforcement"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of creator",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["workspaceId", "ownerId", "userId", "displayName", "email", "role", "status", "canApproveFinancials", "canDeleteRecords", "memberUids", "createdBy", "createdAt", "updatedAt"]
    },
